<INFO name="JOBID" value="833afcd6-a645-11f1-b5c5-bc97e148b76b-O" ucd="meta.id;meta.query"/>
<INFO name="JOBNAME" value=""/>
<INFO name="QUERY_STATUS" value="OK"/>
<INFO name="QUERY" value="SELECT TOP 5000
    source_id, ra, dec, parallax, pmra, pmdec, phot_g_mean_mag, bp_rp, teff_gspphot
FROM gaiadr3.gaia_source
WHERE parallax &gt; 2.0 AND teff_gspphot IS NOT NULL
ORDER BY phot_g_mean_mag ASC" ucd="meta.query"/>

